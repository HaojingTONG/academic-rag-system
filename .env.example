# Academic RAG System - Environment Variables
# =============================================
# Copy this file to .env and customize for your environment

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# Paths
DATA_DIR=./data
VECTOR_DB_PATH=./vector_db
LOG_DIR=./logs
CACHE_DIR=./data/embedding_cache

# Embedding Model
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DEVICE=auto  # auto, cuda, mps, cpu
EMBEDDING_BATCH_SIZE=32

# Retrieval Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_RERANK=true
RETRIEVAL_MMR_DIVERSITY=0.3

# Generation Settings
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=2000

# API Configuration (if web API enabled)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=structured  # structured, json, simple

# Performance
MAX_CONCURRENT_REQUESTS=10
ENABLE_EMBEDDING_CACHE=true

# Feature Flags
ENABLE_WEB_API=false
ENABLE_FACT_CHECK=true
ENABLE_CITATIONS=true
ENABLE_QUERY_EXPANSION=true

# External Services (optional)
# OPENAI_API_KEY=sk-...
# COHERE_API_KEY=...
# ANTHROPIC_API_KEY=...

# Database (if using external vector DB)
# WEAVIATE_URL=http://localhost:8080
# QDRANT_URL=http://localhost:6333
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Monitoring (optional)
# SENTRY_DSN=...
# PROMETHEUS_PORT=9090
# GRAFANA_URL=http://localhost:3000

# Development
DEBUG=false
DEVELOPMENT_MODE=false
ENABLE_PROFILING=false
